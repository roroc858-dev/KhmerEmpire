NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase transaction pooler for the running app; include pgbouncer=true and sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require
# Supabase direct or session-pooler URL for Prisma migrations (not transaction mode).
DIRECT_URL=postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
AUTH_SECRET=change-me
APP_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com
STORE_CURRENCY=USD
MANUAL_PAYMENT_INSTRUCTIONS=Transfer to KhmerEmpire via bank or e-wallet and upload evidence.
SERVER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-key
